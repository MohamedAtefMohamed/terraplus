# =============================================================================
# TerraPulse — environment configuration
# Copy to .env for Docker Compose, or backend/.env for native development.
# The DEMO experience works with every value below left at its default.
# =============================================================================

# --- Data mode ---------------------------------------------------------------
# demo  : generated synthetic SAR scenes (fully offline, default)
# sample: staged real sample products described by backend/data/sample/manifest.json
# live  : live NISAR granule metadata discovery via ASF (analysis remains demo)
# auto  : use sample when staged, otherwise demo
DATA_MODE=demo
LIVE_DISCOVERY_ENABLED=true

# --- NASA Earthdata (optional, not used by the MVP download path) -----------
# Metadata discovery through ASF does not require credentials.
# Downloading protected NASA products would require Earthdata Login.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# --- Optional LLM narration (off by default; deterministic engine is default)
ENABLE_LLM_NARRATION=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- API / CORS --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/terraplus.db
# MAX_ANALYSIS_PIXELS=4000000
# COMPARE_RATE_LIMIT_PER_MINUTE=40

# --- Frontend (baked at Next.js build time) ----------------------------------
# Must be reachable from the user's browser. Use https://api.example.com in prod.
NEXT_PUBLIC_API_URL=http://localhost:8000
