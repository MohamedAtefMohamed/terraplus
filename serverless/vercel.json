{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 90 }
    }
  ],
  "routes": [
    { "src": "/media/(.*)", "dest": "api/main.py" },
    { "src": "/api/(.*)", "dest": "api/main.py" }
  ]
}
